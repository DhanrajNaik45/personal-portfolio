# Copy this file to .env and fill in the values. Never commit .env.

PORT=3000

# Google Sheet that receives each contact message (keep it private)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Contacts

# Service account key: either a file path ...
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# ... or the whole JSON on one line (use this on hosting platforms)
# GOOGLE_SERVICE_ACCOUNT_JSON=
